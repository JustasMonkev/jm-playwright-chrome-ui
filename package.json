{
  "name": "playwright-chrome-ui",
  "version": "0.0.0",
  "description": "Experimental Chrome UI helpers for Playwright",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "25"
  },
  "files": [
    "README.md",
    "index.d.ts",
    "index.js",
    "index.mjs",
    "lib",
    "types"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.js",
    "example:test": "npm run build && playwright test examples/youtube-short-blocker.spec.ts --headed",
    "report": "playwright show-report playwright-report",
    "test": "npm run build && playwright test tests/youtube-short-blocker.spec.ts --headed",
    "test:all": "npm run build && playwright test --headed",
    "test:report": "npm test && npm run report",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "playwright-core": "^1.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3"
  }
}
