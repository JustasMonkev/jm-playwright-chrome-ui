{
  "name": "jm-playwright-chrome-ui",
  "version": "0.1.0",
  "description": "Chrome extension UI helpers for Playwright",
  "keywords": [
    "playwright",
    "chrome",
    "chromium",
    "extension",
    "automation"
  ],
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justasMonkev/playwright-chrome-ui.git"
  },
  "bugs": {
    "url": "https://github.com/justasMonkev/playwright-chrome-ui/issues"
  },
  "homepage": "https://github.com/justasMonkev/playwright-chrome-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.d.ts",
    "index.js",
    "index.mjs",
    "lib",
    "src",
    "types"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=lib/index.js",
    "prepack": "npm run build && npm run typecheck",
    "report": "playwright show-report playwright-report",
    "test": "npm run build && playwright test tests/youtube-short-blocker.spec.ts --headed",
    "test:all": "npm run build && playwright test --headed",
    "test:report": "npm test && npm run report",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "playwright-core": ">=1.59.0 <1.60.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "typescript": "^6.0.3"
  }
}
