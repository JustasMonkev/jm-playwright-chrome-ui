{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "examples/**/*.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
