{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "examples/**/*.ts",
    "playwright.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts",
    "index.d.ts"
  ]
}
